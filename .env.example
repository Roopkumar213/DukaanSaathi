# =====================================================================
# DukaanSaathi - Environment Configuration Template
# Copy this file to .env and configure your local/production settings.
# NEVER commit actual API keys or secrets to version control.
# =====================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# AI Provider Configuration
# Set AI_PROVIDER to 'gemini' for live Gemini API or 'mock' for local offline testing
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp

# Authentication & JWT
JWT_SECRET=your_minimum_256_bit_random_secret_string_here_for_jwt_signing
JWT_EXPIRATION_MS=86400000

# Database Configuration (Used when SPRING_PROFILES_ACTIVE=mysql)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/dukaansaathi_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# Payment & UPI Webhook Configuration
UPI_WEBHOOK_SECRET=your_upi_provider_signature_secret_here
UPI_VERIFICATION_PROVIDER=manual
