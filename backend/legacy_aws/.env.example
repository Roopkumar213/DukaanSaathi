# DukaanAI - Environment Configuration Template
# COPY THIS TO .env (DO NOT COMMIT .env TO GIT)
# All AWS credentials are automatically loaded via IAM Roles (in Lambda)
# or via AWS CLI profile / standard AWS env vars (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY) locally.

# Consistent AWS Region (Recommended: us-east-1 for immediate Bedrock model availability)
AWS_REGION=us-east-1

# Deployment Environment (dev, staging, prod)
ENVIRONMENT=dev

# DynamoDB Single Table Name (Auto-populated by CloudFormation output)
DYNAMODB_TABLE=dukaanai-dev-table

# S3 Bucket for Audio Recordings / Bill OCR Uploads (Auto-populated by CloudFormation output)
MEDIA_BUCKET=dukaanai-dev-media-<account-id>-us-east-1

# Amazon Bedrock Foundation Model for Kirana Natural Language Understanding
# Anthropic Claude 3 Haiku is recommended for hackathons: fast, accurate, and cost-efficient
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# CloudFormation Stack Name
STACK_NAME=dukaanai-dev-stack
